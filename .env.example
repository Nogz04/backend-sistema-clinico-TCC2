# Copie este arquivo para .env e preencha somente na sua máquina.
# Nunca coloque credenciais reais neste arquivo de exemplo ou no Git.
# Não use aspas em volta dos valores.

SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/clinica_IA_TCC?createDatabaseIfNotExist=true&serverTimezone=America/Sao_Paulo
DB_USERNAME=root
DB_PASSWORD=
JPA_DDL_AUTO=update

# Obrigatório. Use um segredo aleatório com pelo menos 32 bytes.
JWT_SECRET=
JWT_EXPIRATION=PT8H

# Opcional: sem chave, somente a análise por IA fica indisponível.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_CONNECT_TIMEOUT=PT5S
GEMINI_REQUEST_TIMEOUT=PT40S
GEMINI_MAX_ATTEMPTS=4
GEMINI_RETRY_DELAY=PT1S
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_INPUT_CHARS=20000
GEMINI_DAILY_TOKEN_LIMIT=0
GEMINI_IDENTIFICAR_FALAS=true
# Convite seguro de médicos
FRONTEND_URL=http://localhost:5500
INVITE_EXPIRATION=PT24H
PASSWORD_RESET_EXPIRATION=PT30M
# Use true apenas no desenvolvimento local, para receber o link na resposta da API.
EXPOSE_INVITE_LINK=true
# Use true somente no desenvolvimento para devolver o link de recuperação na API.
EXPOSE_PASSWORD_RESET_LINK=false
MAIL_ENABLED=false
# Exemplo Gmail. Use uma senha de app, nunca a senha normal da conta Google.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-sem-espacos
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
